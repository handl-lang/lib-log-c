--- log-c -- the libc backend for the `log` contract.
---
--- Leveled records to **stderr** over `ffi.call("libc.so.6", ...)` —
--- no posix dep, no generated adapter, no shell. The sink is libc
--- stdio's `stderr` FILE*: unbuffered under the C stdio model, so each
--- `log` reaches the kernel promptly — the right channel for
--- diagnostics that must not be lost and must not pollute stdout
--- (piped/redirected program output stays clean).
---
--- Line format (the contract's canonical `format`):
---
---   LEVEL ISO-8601-UTC message key=value key=value ...
---
--- e.g. `INFO 2026-11-22T19:42:07.123Z worker started pid=42`.
--- Attrs render in record order; string values are quoted only when
--- they contain characters outside the safe set `[A-Za-z0-9_./:@+-]`
--- (spaces, quotes, backslashes, controls), with `"` and `\` escaped —
--- the slog TextHandler convention. Non-string values render through
--- `type.to_string`.
---
--- Timestamp: `clock_gettime(CLOCK_REALTIME)` -> epoch ms -> proleptic
--- Gregorian civil date (the days-from-civil algorithm, same one
--- `lib-datetime` uses) formatted `YYYY-MM-DDTHH:MM:SS.mmmZ`. Always
--- UTC — no `localtime`/`TZ` dependence, so output is reproducible.
---
--- Syslog sink: `make_syslog(min, attrs, opts)` builds a logger whose
--- `sink` field is `"syslog"` — records go to `syslog(3)` instead of
--- stderr. The variadic problem is sidestepped, not solved: `syslog`'s
--- format argument is always the constant `"%s"` and the fully-rendered
--- message rides as the third (vararg) parameter, so the ffi's fixed
--- three-argument signature `syslog(int, char*, char*)` is exactly what
--- a C caller would emit (the `curl_easy_setopt` precedent in
--- lib-fetch-c — SysV passes int/ptr varargs identically, and `"%s"`
--- never touches the XMM save area). `openlog(ident, LOG_PID, facility)`
--- is called before each `syslog` so every emit carries the logger's
--- own ident/facility — openlog is a pure globals-set, idempotent, and
--- far cheaper than the syslog sendto it precedes.
---
--- The syslog line is `msg key=value ...` — NO `LEVEL`/ISO-8601
--- prefix: syslog stamps its own timestamp and encodes the level in
--- the priority word (`facility | LOG_*`), so the canonical `format`
--- header would be redundant noise in `journalctl`/`/var/log`.
---
--- `opts` is `null` or a record `{ facility: Int, ident: String }`:
--- `facility` is the C `LOG_*` constant value (already <<3-shifted —
--- LOG_USER=8, LOG_DAEMON=24, LOG_LOCAL0=128 .. LOG_LOCAL7=184),
--- default 8; `ident` is the syslog tag, default `"handl"`. The fields
--- live on the logger record, so `child`/`with_level` preserve them
--- for free (the contract's "backends MAY add fields" clause).
---
--- `ident` is `strdup`'d once here and the pointer stored as
--- `ident_ptr`: `openlog` keeps the `ident` pointer (it does NOT copy
--- the string — glibc stores `LogIdent = ident`), while an ffi `"cstr"`
--- arg only lives until its call returns. A per-emit `"cstr"` ident
--- would dangle into freed heap — journal showed `SYSLOG_IDENTIFIER`
--- as `[5B blob data]`/`proj_child` garbage before this fix. One
--- strdup per logger is the honest cost (a few bytes, never freed —
--- idents are few and process-lived).
---
--- `ffi`, `math`, `type`, `hash_map` are host modules on the stdlib
--- chain — reached by qualified call with no import line (the
--- intl-c/stdio-c convention). `str`, `bytes`, `obj`, `char` are
--- stdlib modules. `error` is imported as `raise` because this module
--- EXPORTS an arrow named `error` (the fatal-level convenience), which
--- would otherwise shadow the host `error` module inside the file.

from "str" import * as strm
from "bytes" import * as bytesm
from "obj" import * as obj
from "char" import * as charm
from "error" import { raise }

LIBC := "libc.so.6"

--- errno retried rather than raised.
EINTR := 4

-- ---------------------------------------------------------------------------
-- Levels (contract: "trace" < "debug" < "info" < "warn" < "error" < "fatal")
-- ---------------------------------------------------------------------------

--- rank: 0..5 for the six level names, -1 for anything else.
rank := (lvl) ~> if lvl == "trace" {
  0
} else if lvl == "debug" {
  1
} else if lvl == "info" {
  2
} else if lvl == "warn" {
  3
} else if lvl == "error" {
  4
} else if lvl == "fatal" {
  5
} else {
  -1
}

--- Reject an unrecognised level — `log: unknown level '<name>'`.
need_level := (lvl) ~> if rank(lvl) < 0 {
  raise("log: unknown level '" + type.to_string(lvl) + "'")
} else {
  null
}

-- ---------------------------------------------------------------------------
-- Pure logger algebra (contract: make / with_level / child / should_log)
-- ---------------------------------------------------------------------------

--- attrs_or_empty: null -> {}, record -> itself.
attrs_or_empty := (a) ~> if a == null { {} } else { a }

--- merge(base, extra): `extra`'s entries set over `base` — the
--- right-hand (child/event) value wins on a key collision.
merge := (base, extra) ~> if extra == null {
  base
} else {
  while { es: obj.entries(extra), acc: base } {
    (es, acc) ~> match es {
      []: { out: acc },
      [h, ...t]: { state: { es: t, acc: obj.set(acc, h[0], h[1]) } }
    }
  }
}

--- make(min, attrs): `{ min_level, attrs }` — attrs normalised to {}.
make := (min, attrs) ~> do {
  need_level(min)
  { min_level: min, attrs: attrs_or_empty(attrs) }
}

--- with_level(l, lvl): l with min_level replaced (extra fields kept).
with_level := (l, lvl) ~> do {
  need_level(lvl)
  obj.set(l, "min_level", lvl)
}

--- child(l, attrs): l with `attrs` merged into its carried attrs.
child := (l, attrs) ~> obj.set(l, "attrs", merge(l.attrs, attrs))

--- should_log(l, lvl): rank(lvl) >= rank(l.min_level); unknown -> false.
should_log := (l, lvl) ~> rank(lvl) >= rank(l.min_level)

export level_rank := rank
export make := make
export with_level := with_level
export child := child
export should_log := should_log

-- ---------------------------------------------------------------------------
-- Syslog sink (backend extension — not part of the `log` contract's
-- minimum surface; see the header for the "%s"-vararg trick)
-- ---------------------------------------------------------------------------

--- C `LOG_*` level codes for the syslog priority word (DEBUG=7 .. CRIT=2).
syslog_level := (lvl) ~> if lvl == "trace" || lvl == "debug" {
  7
} else if lvl == "info" {
  6
} else if lvl == "warn" {
  4
} else if lvl == "error" {
  3
} else {
  2
}

--- make_syslog(min, attrs, opts): a `make` logger whose `sink` is
--- `"syslog"`. `opts` is null or `{ facility, ident }` — facility is the
--- C `LOG_*` constant (default LOG_USER = 8), ident the syslog tag
--- (default `"handl"`). openlog still runs at emit time; the only
--- eager work is the one-time `strdup` of `ident` (see the header —
--- the ffi `"cstr"` lifetime is per-call, `openlog` needs it forever).
make_syslog := (min, attrs, opts) ~> do {
  need_level(min)
  o := if opts == null { {} } else { opts }
  fac := hash_map.get_or(o, "facility", 8)
  ident := hash_map.get_or(o, "ident", "handl")
  if type.of(fac) != "number" || math.is_integer(fac) == false {
    raise("log: syslog: facility must be an integer")
  } else if type.of(ident) != "string" {
    raise("log: syslog: ident must be a string")
  } else {
    ip := ffi.call(LIBC, "strdup", [ident], ["cstr"], "ptr", false)
    if ip == 0 {
      raise("log: syslog: strdup failed")
    } else {
      { min_level: min, attrs: attrs_or_empty(attrs),
        sink: "syslog", facility: fac, ident: ident, ident_ptr: ip }
    }
  }
}

export make_syslog := make_syslog

-- ---------------------------------------------------------------------------
-- Canonical rendering (contract: format)
-- ---------------------------------------------------------------------------

--- Chars that never force quoting: ASCII alnum plus _./:@+-.
SAFE := "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_./:@+-"

--- needs_quote(s): empty or any char outside SAFE.
needs_quote := (s) ~> do {
  if strm.length(s) == 0 {
    true
  } else {
    while { cs: charm.chars(s), bad: false } {
      (cs, bad) ~> match cs {
        []: { out: bad },
        [c, ...t]: { state: { cs: t, bad: bad || strm.find(SAFE, c) < 0 } }
      }
    }
  }
}

--- Escape `"` and `\` inside a quoted string.
esc := (s) ~> while { cs: charm.chars(s), acc: "" } {
  (cs, acc) ~> match cs {
    []: { out: acc },
    ["\\", ...t]: { state: { cs: t, acc: acc + "\\\\" } },
    ["\"", ...t]: { state: { cs: t, acc: acc + "\\\"" } },
    [c, ...t]: { state: { cs: t, acc: acc + c } }
  }
}

--- Render one attr value: strings quoted iff needed, else type.to_string.
show := (v) ~> if type.of(v) == "string" {
  if needs_quote(v) { "\"" + esc(v) + "\"" } else { v }
} else {
  type.to_string(v)
}

--- format(ts, lvl, msg, attrs): `"LEVEL ts msg k=v ..."` — level
--- uppercased, attrs in record order, null attrs render nothing.
format := (ts, lvl, msg, attrs) ~> do {
  need_level(lvl)
  head := strm.upper(lvl) + " " + ts + " " + msg
  a := attrs_or_empty(attrs)
  while { es: obj.entries(a), acc: head } {
    (es, acc) ~> match es {
      []: { out: acc },
      [h, ...t]: { state: { es: t, acc: acc + " " + h[0] + "=" + show(h[1]) } }
    }
  }
}

export format := format

-- ---------------------------------------------------------------------------
-- Timestamp: clock_gettime(CLOCK_REALTIME) -> ISO-8601 UTC, ms precision.
-- ---------------------------------------------------------------------------

CLOCK_REALTIME := 0

--- `strerror(errno)` — the C message, or a bare "errno <n>".
strerror := (n) ~> do {
  s := ffi.call(LIBC, "strerror", [n], ["i32"], "cstr", false)
  if s == null { "errno " + type.to_string(n) } else { s }
}

--- clock_gettime(2) -> epoch milliseconds (the posix-c `read_ns`
--- shape: out_struct into libc, errno on failure).
now_ms := () ~> do {
  r := ffi.call(LIBC, "clock_gettime", [CLOCK_REALTIME],
    ["i32", "out_struct:{tv_sec:i64,tv_nsec:i64}"], "i32", false)
  if r.ret < 0 {
    raise("log: clock_gettime: " + strerror(ffi.errno()))
  } else {
    r.buf.tv_sec * 1000 + math.floor_div(r.buf.tv_nsec, 1000000)
  }
}

pad2 := (n) ~> strm.pad_left(type.to_string(n), 2, "0")
pad4 := (n) ~> strm.pad_left(type.to_string(n), 4, "0")

--- Proleptic Gregorian civil date from days since 1970-01-01
--- (Howard Hinnant's civil_from_days — the lib-datetime algorithm).
civil := (days) ~> do {
  z := days + 719468
  era := math.floor_div(z, 146097)
  doe := z - era * 146097
  yoe := math.floor_div(doe - math.floor_div(doe, 1460)
    + math.floor_div(doe, 36524) - math.floor_div(doe, 146096), 365)
  y := yoe + era * 400
  doy := doe - (365 * yoe + math.floor_div(yoe, 4) - math.floor_div(yoe, 100))
  mp := math.floor_div(5 * doy + 2, 153)
  d := doy - math.floor_div(153 * mp + 2, 5) + 1
  m := mp + (if mp < 10 { 3 } else { 0 - 9 })
  { y: y + (if m <= 2 { 1 } else { 0 }), m: m, d: d }
}

--- ISO-8601 UTC timestamp with millisecond precision:
--- `YYYY-MM-DDTHH:MM:SS.mmmZ`.
iso_now := () ~> do {
  ms := now_ms()
  days := math.floor_div(ms, 86400000)
  sod := ms - days * 86400000
  c := civil(days)
  hh := math.floor_div(sod, 3600000)
  mi := math.floor_div(sod - hh * 3600000, 60000)
  ss := math.floor_div(sod - hh * 3600000 - mi * 60000, 1000)
  mmm := sod - hh * 3600000 - mi * 60000 - ss * 1000
  pad4(c.y) + "-" + pad2(c.m) + "-" + pad2(c.d)
    + "T" + pad2(hh) + ":" + pad2(mi) + ":" + pad2(ss)
    + "." + strm.pad_left(type.to_string(mmm), 3, "0") + "Z"
}

-- ---------------------------------------------------------------------------
-- Sink: fwrite(line + "\n", stderr FILE*) — libc owns the (un)buffering.
-- ---------------------------------------------------------------------------

--- Resolve a libc global data symbol and read the pointer it stores
--- (`stderr` is a `FILE *` global — the stdio-c `file_stream` pattern).
file_stream := (name) ~> do {
  r := ffi.sym(LIBC, name)
  if hash_map.get_or(r, "__tag__", "") != "ok" {
    raise("log: " + name + ": "
      + type.to_string(hash_map.get_or(r, "value", "")))
  } else {
    ffi.read(hash_map.get_or(r, "value", 0), "ptr")
  }
}

--- One `fwrite` of `s` + "\n" to stderr. `in_buf` expands the Bytes to
--- C's (ptr, len) pair, so the call marshals as
--- `fwrite(ptr, len, 1, stream)` — size=len, nmemb=1, and the return is
--- the item count: 1 on success, 0 on error (the stdio-c convention).
emit := (s) ~> do {
  b := bytesm.utf8_encode(s + "\n")
  stream := file_stream("stderr")
  r := ffi.call(LIBC, "fwrite", [b, 1, stream],
    ["in_buf", "i64", "ptr"], "i64", false)
  if r != 1 {
    raise("log: write: " + strerror(ffi.errno()))
  } else {
    null
  }
}

-- ---------------------------------------------------------------------------
-- Sink: syslog(3) — openlog + syslog("%s", msg) per record (see header).
-- ---------------------------------------------------------------------------

--- LOG_PID — openlog option: tag every record with the process id.
LOG_PID := 1

--- `" k=v k=v"` suffix for the merged attrs — the same quoting rules as
--- `format`, minus the LEVEL/timestamp head syslog supplies itself.
attrs_suffix := (attrs) ~> while { es: obj.entries(attrs_or_empty(attrs)), acc: "" } {
  (es, acc) ~> match es {
    []: { out: acc },
    [h, ...t]: { state: { es: t, acc: acc + " " + h[0] + "=" + show(h[1]) } }
  }
}

--- One syslog record: `openlog(ident, LOG_PID, facility)` then
--- `syslog(facility | level, "%s", msg + attrs)`. `syslog` returns void
--- and reports delivery failures only via its own internal logging —
--- there is no errno to check, so a dropped datagram is silent by
--- design (same as every syslog client).
syslog_emit := (l, lvl, msg, attrs) ~> do {
  fac := hash_map.get_or(l, "facility", 8)
  ident := hash_map.get_or(l, "ident", "handl")
  -- `openlog` retains the ident pointer (no copy), so it must outlive
  -- the call: `make_syslog` loggers carry `ident_ptr` (a strdup'd
  -- address). A hand-built `{ sink: "syslog" }` record without one
  -- falls back to a per-emit strdup — correct but leaks per record;
  -- `make_syslog` is the supported constructor.
  ip := hash_map.get_or(l, "ident_ptr", null)
  p := if ip == null {
    ffi.call(LIBC, "strdup", [ident], ["cstr"], "ptr", false)
  } else {
    ip
  }
  ffi.call(LIBC, "openlog", [p, LOG_PID, fac],
    ["ptr", "i32", "i32"], "void", false)
  ffi.call(LIBC, "syslog",
    [math.bit_or(fac, syslog_level(lvl)), "%s", msg + attrs_suffix(attrs)],
    ["i32", "cstr", "cstr"], "void", false)
  null
}

--- sink_of(l): the logger's sink tag — `"syslog"` or `"stderr"`.
sink_of := (l) ~> hash_map.get_or(l, "sink", "stderr")

-- ---------------------------------------------------------------------------
-- Contract surface — emission (effectful)
-- ---------------------------------------------------------------------------

--- log(l, lvl, msg, attrs): emit `format(iso_now(), lvl, msg, merged)`
--- to the logger's sink (stderr by default, syslog when `l.sink` is
--- `"syslog"`) iff should_log. Filtered records are dropped silently.
log := (l, lvl, msg, attrs) ~> do {
  need_level(lvl)
  if should_log(l, lvl) {
    a := merge(l.attrs, attrs)
    if sink_of(l) == "syslog" {
      syslog_emit(l, lvl, msg, a)
    } else {
      emit(format(iso_now(), lvl, msg, a))
    }
  } else {
    null
  }
}

export log := log

--- Per-level conveniences — `log` with the level fixed.
export trace := (l, msg, attrs) ~> log(l, "trace", msg, attrs)
export debug := (l, msg, attrs) ~> log(l, "debug", msg, attrs)
export info  := (l, msg, attrs) ~> log(l, "info",  msg, attrs)
export warn  := (l, msg, attrs) ~> log(l, "warn",  msg, attrs)
export error := (l, msg, attrs) ~> log(l, "error", msg, attrs)
export fatal := (l, msg, attrs) ~> log(l, "fatal", msg, attrs)

--- flush(l): stderr is unbuffered — contract no-op.
export flush := (l) ~> null
